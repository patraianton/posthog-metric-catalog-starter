# Copy to .env and fill in. .env is in .gitignore.
# Personal API key: PostHog > Settings > Personal API keys. Not the project key.
# Scopes for the agent and the push script: data_catalog:read, data_catalog:write, query:read,
# warehouse_view:write (creates the saved view), insight:read (metrics made from insights).
# Do not give it data_catalog_approval:write: approvals stay on the owner key.
POSTHOG_API_KEY=
# https://us.posthog.com or https://eu.posthog.com
POSTHOG_HOST=https://us.posthog.com
# The number in your project URL: /project/<id>/
POSTHOG_PROJECT_ID=
